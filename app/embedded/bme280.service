[Unit]
Description=Servidor BME280 - Dashboard Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@PROJECT_ROOT@/app/embedded
ExecStart=@PROJECT_ROOT@/app/embedded/bme280_server
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Executar script para mostrar IP após iniciar
ExecStartPost=/bin/bash -c 'sleep 3 && echo "Servidor BME280 iniciado! Acesse: http://$(hostname -I | awk "{print \$1}"):8080"'

[Install]
WantedBy=multi-user.target
